#!/bin/sh /etc/rc.common
# /etc/init.d/tcp_node: run the yggdrasil-lite tcp_node as a service on OpenWrt.
#
# Install:
#   cp tcp_node.init /etc/init.d/tcp_node && chmod +x /etc/init.d/tcp_node
#   /etc/init.d/tcp_node enable && /etc/init.d/tcp_node start
#
# Settings below. Empty FORWARD or API turns that feature off.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/tcp_node
KEY=/root/ygg.key
PEERS=/root/peers.json
# Outbound peers to keep connected (1..32).
TARGET=2
# Public keys (hex) allowed to reach this router, space-separated. Each key
# can use the forwarded ports below. Replace the placeholder.
ALLOW="REPLACE_WITH_CLIENT_PUBLIC_KEY"
# Overlay ports to forward to the router's local ports: "22" or "2222:22,8080".
# Only allowed keys can connect. Example: SSH on the router's port 22.
FORWARD="22"
# Local status API, e.g. 127.0.0.1:8080 (empty = off). Open http://127.0.0.1:8080/
API=""
# Seconds between root checks (>= 10).
QUALITY_INTERVAL=300

start_service() {
	[ -x "$PROG" ] || return 1

	# Build the argument list; optional settings are added only when set.
	set -- "$PROG" --key "$KEY" --peers "$PEERS" --target "$TARGET" --quality-interval "$QUALITY_INTERVAL"
	for key in $ALLOW; do
		set -- "$@" --allow "$key"
	done
	[ -n "$FORWARD" ] && set -- "$@" --forward "$FORWARD"
	[ -n "$API" ] && set -- "$@" --api "$API"

	procd_open_instance
	procd_set_param command "$@"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
